{
  "name": "dsh-write-guard",
  "version": "0.6.9",
  "description": "Content-aware file write protection for DeepSeek Harness agents: scan proposed writes and shell output targets, verify direct writes by hash, and rescan files after edits. Includes project rules, hash-chained audit logs, and plugin integrity checks. 为 DeepSeek Harness 的 Agent 检查写入内容和 Shell 写入目标，写后校验并重扫，支持项目规则、哈希链审计和插件自校验。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "GUIDE-zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai-agent",
    "dsh-plugins",
    "cordis",
    "deepseek",
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "security",
    "write-protection",
    "malware",
    "guard",
    "quarantine",
    "content-scan"
  ],
  "author": "T4ngK1ng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4ngk1ng-droid/dsh-write-guard.git"
  },
  "homepage": "https://github.com/t4ngk1ng-droid/dsh-write-guard#readme",
  "bugs": {
    "url": "https://github.com/t4ngk1ng-droid/dsh-write-guard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}