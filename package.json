{
  "name": "dsh-write-guard",
  "version": "0.4.0",
  "description": "Content-aware write protection for DeepSeek Harness: scans file writes and shell redirects before they land, verifies hashes after, detects payloads split across writes, enforces project custom rules, chains the audit log, and fingerprints its own files. 内容级写入防护：落盘前扫描文件写入与 shell 重定向，落盘后校验哈希与全文，检测分片拼接，支持项目自定义规则、哈希链审计与插件自校验。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "GUIDE-zh.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "security",
    "write-protection",
    "malware",
    "guard",
    "quarantine",
    "content-scan"
  ],
  "author": "T4ngK1ng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4ngk1ng-droid/dsh-write-guard.git"
  },
  "homepage": "https://github.com/t4ngk1ng-droid/dsh-write-guard#readme",
  "bugs": {
    "url": "https://github.com/t4ngk1ng-droid/dsh-write-guard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
